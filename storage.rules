rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {


    match /materials/{classId}/{fileName} {

      allow read:
        if request.auth != null;


      allow write:
        if request.auth != null;

    }


    match /worksheets/{userId}/{fileName} {

      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;

    }


    match /{allPaths=**} {

      allow read, write: if false;

    }

  }

}
